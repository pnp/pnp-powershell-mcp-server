<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;osx-arm64;osx-x64;linux-x64;linux-arm64;linux-musl-x64</RuntimeIdentifiers>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PnPPowerShell.MCPServer</RootNamespace>

    <!-- This project lives at the repo root, so its default **/*.cs glob would otherwise compile the test project too. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>

    <!-- Set up the NuGet package to be an MCP server -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pnp-powershell-mcp-server</ToolCommandName>
    <PackageType>McpServer</PackageType>

    <!-- Set up the MCP server to be a self-contained application that does not rely on a shared framework -->
    <SelfContained>true</SelfContained>
    <PublishSelfContained>true</PublishSelfContained>

    <!-- Set up the MCP server to be a single file executable -->
    <PublishSingleFile>true</PublishSingleFile>

    <!-- Configure the MCP server to be a native AOT application with invariant globalization -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Set recommended package metadata -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>PnP.PowerShell.MCPServer</PackageId>
    <PackageVersion>0.1.5-beta</PackageVersion>
    <Authors>PnP Community</Authors>
    <PackageTags>AI; MCP; server; stdio; PnP; PowerShell; SharePoint; Microsoft365</PackageTags>
    <Description>Model Context Protocol (MCP) server for PnP PowerShell that allows managing Microsoft 365 (SharePoint Online, Teams, Entra ID, and more) using natural language, and helps developers author complex PnP PowerShell scripts.</Description>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/pnp/pnp-powershell-mcp-server</RepositoryUrl>
    <PackageProjectUrl>https://github.com/pnp/pnp-powershell-mcp-server</PackageProjectUrl>
  </PropertyGroup>

  <!-- Include additional files for browsing the MCP server. -->
  <ItemGroup>
    <None Include=".mcp\server.json" Pack="true" PackagePath="/.mcp/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="LICENSE" Pack="true" PackagePath="/" />
    <!-- Compiled in, so the guidance cannot drift from a second copy and is always present at runtime. -->
    <EmbeddedResource Include="best-practices.md" LogicalName="best-practices.md" />
    <!-- Vendored so the sample and cmdlet indexes answer with no network and no VS Code extension. Refresh with build/Update-VendoredData.ps1. -->
    <EmbeddedResource Include="data\script-samples.json" LogicalName="script-samples.json" />
    <EmbeddedResource Include="data\pnp-commands.json" LogicalName="pnp-commands.json" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>PnPPowerShell.MCPServer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="ModelContextProtocol.Extensions.Tasks" Version="2.2.0" />
  </ItemGroup>

</Project>
